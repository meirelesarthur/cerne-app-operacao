{
  "name": "cerne-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "cd apps/mobile && flutter run -d chrome",
    "dev:react:rollback": "vite",
    "build": "node scripts/build-flutter-site.mjs",
    "build:react:rollback": "tsc -b && vite build",
    "preview:react:rollback": "vite preview",
    "lint": "cd apps/mobile && flutter analyze --fatal-infos",
    "lint:react:rollback": "tsc -b --noEmit",
    "test": "cd apps/mobile && flutter test",
    "quality:functional": "cd apps/mobile && flutter test test/architecture/component_first_test.dart test/architecture/token_integrity_test.dart test/modules/fazendas/functional_catalog_test.dart test/modules/fazendas/functional_journey_engine_test.dart test/router/access_policy_test.dart test/router/app_router_test.dart",
    "quality:react:rollback": "node scripts/validate-functional-catalog.mjs",
    "tokens:export": "tsx scripts/export-tokens-dtcg.ts",
    "tokens:export:flutter": "tsx scripts/export-tokens-flutter.ts && dart format apps/mobile/lib/design/generated",
    "tokens:verify": "npm run tokens:export && npm run tokens:export:flutter && git diff --exit-code -- tokens/tokens.json apps/mobile/lib/design/generated",
    "smoke:deploy": "node scripts/smoke-flutter-deploy.mjs"
  },
  "dependencies": {
    "@fontsource/outfit": "^5.2.8",
    "lucide-react": "^0.414.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/node": "^22.5.5",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.19.1",
    "typescript": "^5.5.4",
    "vite": "^6.0.3",
    "wrangler": "4.123.0"
  }
}
